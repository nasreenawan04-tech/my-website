modules = ["nodejs-20", "python-3.12", "web"]
[agent]
expertMode = true
integrations = ["javascript_openai:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 80

[[ports]]
localPort = 38137
externalPort = 3001

[[ports]]
localPort = 39605
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[userenv]

[userenv.shared]
VITE_GTM_ID = "GTM-T57J5T4B"
VITE_FIREBASE_AUTH_DOMAIN = "dapsiwow.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID = "dapsiwow"
VITE_FIREBASE_STORAGE_BUCKET = "dapsiwow.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID = "215234393623"
VITE_FIREBASE_APP_ID = "1:215234393623:web:aee78956496745b0de0e52"
